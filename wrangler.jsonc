{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coin-treemap",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // ── Cloudflare D1 데이터베이스 바인딩 ──────────────────
  // wrangler d1 create coin-treemap-db 실행 후
  // 출력된 database_id를 아래에 붙여넣으세요
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "coin-treemap-db",
      "database_id": "여기에-d1-database-id-입력"
    }
  ]
}
